# Zetaris (REST adapter). URL and org are the local Docker defaults; the API key comes from the Zetaris GUI and stays out of every commit.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# Meterless Nightshift (primary AI provider)
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
# Run mode
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000
